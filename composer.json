{
    "name": "wpapp/user-tables",
    "description": "This plugin displays users in a dynamic table.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0+",
    "authors": [
        {
            "name": "Oleh Kosarenko",
            "email": "kosarenko.oleh@gmail.com"
        }
    ],
    "support": {
        "src": "https://github.com/olehkosarenko/user-tables",
        "issues": "https://github.com/olehkosarenko/user-tables/issues"
    },
    "require": {
        "php": ">=7.4",
        "psr/log": "~1.0"
    },
    "autoload": {
        "psr-4": {
            "WpApp\\UserAtlas\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "automattic/vipwpcs": "^3.1"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "scripts-descriptions": {
        "lint": "Check PHP code against the coding standards.",
        "lint:fix": "Fix coding standard violations automatically."
    }
}
